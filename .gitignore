# Entorno y secretos
.env
.conda/
.venv/
venv/

# Entorno cursor
# Cursor (local)
.cursor/
.cursorrules
*.plan.md
.cursorignore

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/

# Salidas del pipeline (se regeneran)
data/raw/*.html
data/processed/*.txt
data/json/*.json
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/json/.gitkeep
!data/json/ejemplo_N001.json

# Notas generadas del vault (se conservan las carpetas)
obsidian_vault/**/*.md
!obsidian_vault/**/.gitkeep

# Material docente local (no subir a GitHub)
docs/

# Sistema
.DS_Store
*.swp

# Editor
.vscode/

# Obsidian
obsidian_vault/.obsidian
